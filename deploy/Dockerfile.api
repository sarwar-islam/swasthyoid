# API and the three workers (extract, safety, notify) share this image; compose picks the command.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml ./
COPY swasthyoid ./swasthyoid
RUN pip install --no-cache-dir . && useradd --system --uid 10001 app && mkdir -p /data/documents && chown app /data/documents
USER app
EXPOSE 8000
# --proxy-headers: the client address (rate limit, audit) is the visitor's, as nginx forwards it
CMD ["uvicorn", "swasthyoid.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
