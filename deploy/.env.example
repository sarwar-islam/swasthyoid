# Copy to deploy/.env (never committed) and fill every value. Generate Fernet keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and the other secrets with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
PII_KEY=
DOCUMENT_KEY=
EXTRACTION_KEY=
HMAC_KEY=
JWT_SECRET=
# production | development. development + DEV_LOG_CODES=1 writes sign-in codes to the API log: synthetic demo only,
# never with real people (there is no SMS gateway until S2).
APP_ENV=production
DEV_LOG_CODES=0
RATE_LIMIT_PER_MINUTE=300
NOTIFY_CHANNEL=in_app
