{
  "notice": "SYNTHETIC technical cases. They test that the M6 engine behaves as specified (deterministic, fail closed, explicit not-run checks). They are NOT clinical validation: every drug, ingredient, allergen and rule here is made up. The clinician-written golden cases (FRD M6, 8.5) are REVIEWER-PENDING until FRD Q7 is resolved and go in golden/clinical/.",
  "catalog": [
    {"id": "SYNTH-C1", "generic": "synthgen-alpha", "brands": ["SYNTHBRAND-A"]},
    {"id": "SYNTH-C2", "generic": "synthgen-beta", "brands": ["SYNTHBRAND-B"]},
    {"id": "SYNTH-C3", "generic": "synthgen-alpha + synthgen-beta", "brands": ["SYNTHCOMBO-AB"]},
    {"id": "SYNTH-C4", "generic": "synthgen-gamma", "brands": ["SYNTHBRAND-G"]},
    {"id": "SYNTH-C5", "generic": "synthgen-delta", "brands": ["SYNTHBRAND-X"]},
    {"id": "SYNTH-C6", "generic": "synthgen-epsilon", "brands": ["SYNTHBRAND-X"]}
  ],
  "rules": {
    "ddi-ab": {"rule_type": "ddi", "severity": "major", "definition": {"schema": 1, "ingredients": ["synthgen-alpha", "synthgen-beta"]}},
    "allergy-a": {"rule_type": "allergy", "severity": "contraindicated", "definition": {"schema": 1, "allergen_terms": ["SYNTH-ALLERGEN alpha"], "ingredients": ["synthgen-alpha"]}},
    "dup-g": {"rule_type": "duplicate", "severity": "moderate", "definition": {"schema": 1, "ingredients": ["synthgen-gamma"]}},
    "bad-shape": {"rule_type": "ddi", "severity": "major", "definition": {"placeholder": "SYNTH", "drugs": ["SYNTH-DRUG-001"]}}
  },
  "cases": [
    {"case_id": "SYNTH-GC-01", "about": "pair across the new prescription and a recorded medication",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTHBRAND-A 500 mg"]], "recorded": [["m1", "SYNTHBRAND-B"]],
     "expect": {"alerts": [["ddi-ab", ["m1", "n1"]]]}},
    {"case_id": "SYNTH-GC-02", "about": "pair inside one prescription",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTHBRAND-A"], ["n2", "Tab. synthbrand-b, 1+0+1"]],
     "expect": {"alerts": [["ddi-ab", ["n1", "n2"]]]}},
    {"case_id": "SYNTH-GC-03", "about": "one combination product holds both ingredients",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTHCOMBO-AB"]],
     "expect": {"alerts": [["ddi-ab", ["n1"]]]}},
    {"case_id": "SYNTH-GC-04", "about": "an unrelated medication: no alert",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTHBRAND-A"]], "recorded": [["m1", "SYNTHBRAND-G"]],
     "expect": {"alerts": []}},
    {"case_id": "SYNTH-GC-05", "about": "allergy term written in the allergy text, matching ingredient",
     "rules": ["allergy-a"], "prescription": [["n1", "SYNTHBRAND-A"]], "allergies": [["a1", "Allergic to synth-allergen ALPHA, dust"]],
     "expect": {"alerts": [["allergy-a", ["a1", "n1"]]]}},
    {"case_id": "SYNTH-GC-06", "about": "allergy term words in another order: no match",
     "rules": ["allergy-a"], "prescription": [["n1", "SYNTHBRAND-A"]], "allergies": [["a1", "alpha SYNTH-ALLERGEN"]],
     "expect": {"alerts": []}},
    {"case_id": "SYNTH-GC-07", "about": "allergy term present, ingredient not prescribed: no alert",
     "rules": ["allergy-a"], "prescription": [["n1", "SYNTHBRAND-G"]], "allergies": [["a1", "SYNTH-ALLERGEN alpha"]],
     "expect": {"alerts": []}},
    {"case_id": "SYNTH-GC-08", "about": "the same ingredient already recorded",
     "rules": ["dup-g"], "prescription": [["n1", "SYNTHBRAND-G"]], "recorded": [["m1", "synthgen-gamma ৫০০ mg"]],
     "expect": {"alerts": [["dup-g", ["m1", "n1"]]]}},
    {"case_id": "SYNTH-GC-09", "about": "a drug not in the catalog is flagged, never passed",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTH-UNKNOWN-DRUG"]], "recorded": [["m1", "SYNTHBRAND-B"]],
     "expect": {"alerts": [], "unrecognised": [["n1", "not_in_catalog", "prescription"]]}},
    {"case_id": "SYNTH-GC-10", "about": "a brand with two different generics is ambiguous, flagged",
     "rules": ["ddi-ab"], "prescription": [["n1", "SYNTHBRAND-X"]], "recorded": [["m1", "nothing known"]],
     "expect": {"alerts": [], "unrecognised": [["n1", "ambiguous", "prescription"], ["m1", "not_in_catalog", "recorded"]]}},
    {"case_id": "SYNTH-GC-11", "about": "an approved rule that does not fit its shape blocks the whole check",
     "rules": ["ddi-ab", "bad-shape"], "prescription": [["n1", "SYNTHBRAND-A"]], "recorded": [["m1", "SYNTHBRAND-B"]],
     "expect": {"blocked": "rule_load_error"}},
    {"case_id": "SYNTH-GC-12", "about": "no catalog blocks the check",
     "rules": ["ddi-ab"], "no_catalog": true, "prescription": [["n1", "SYNTHBRAND-A"]],
     "expect": {"blocked": "catalog_unavailable"}},
    {"case_id": "SYNTH-GC-13", "about": "no approved rule: nothing fires, and the checks that cannot run are listed",
     "rules": [], "prescription": [["n1", "SYNTHBRAND-A"]], "recorded": [["m1", "SYNTHBRAND-B"]],
     "expect": {"alerts": []}}
  ]
}
